{
  "name": "textlint-rule-allowed-uris",
  "version": "2.0.3",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "."
  ],
  "description": "A textlint rule for checking allowed URIs in links and images of Markdown.🔥",
  "main": "src/textlint-rule-allowed-uris.js",
  "exports": {
    ".": {
      "types": "./build/textlint-rule-allowed-uris.d.ts",
      "default": "./src/textlint-rule-allowed-uris.js"
    },
    "./package.json": "./package.json"
  },
  "types": "build/textlint-rule-allowed-uris.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./build/*"
      ],
      ".": [
        "./build/textlint-rule-allowed-uris.d.ts"
      ]
    }
  },
  "files": [
    "build/textlint-rule-allowed-uris.d.ts",
    "src/textlint-rule-allowed-uris.js",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "textlintrule",
    "textlint",
    "lint",
    "rule",
    "uri",
    "url",
    "checker"
  ],
  "author": "lumir <rpfos@naver.com> (https://github.com/lumirlumir)",
  "funding": "https://github.com/sponsors/lumirlumir",
  "license": "MIT",
  "homepage": "https://github.com/lumirlumir/npm-textlint-rule-allowed-uris",
  "repository": {
    "type": "github",
    "url": "git+https://github.com/lumirlumir/npm-textlint-rule-allowed-uris.git"
  },
  "bugs": {
    "url": "https://github.com/lumirlumir/npm-textlint-rule-allowed-uris/issues"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "prepare": "husky",
    "release:publish": "node -e \"require('child_process').execSync('npm publish ' + (require('./package.json').version.includes('-') ? '--tag next' : ''), { stdio: 'inherit' })\"",
    "prepublishOnly": "npm run build",
    "build": "tsc -b",
    "test": "node --test && npm-run-all -c -l -p textlint-*",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\" && node --test --experimental-test-coverage --test-coverage-exclude=\"**/build/**\" --test-coverage-exclude=\"**/*.test.{js,mjs,cjs}\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info && npm-run-all -c -l -p textlint-*",
    "fix": "npm-run-all -c -l -p fix:*",
    "fix:eslint": "eslint --fix --cache --cache-strategy content",
    "fix:prettier": "prettier . --write --ignore-unknown",
    "lint": "npm-run-all -c -l -p lint:*",
    "lint:eslint": "eslint --cache --cache-strategy content",
    "lint:prettier": "prettier . --check --ignore-unknown",
    "lint:editorconfig": "editorconfig-checker -config .editorconfig-checker.json",
    "lint:textlint": "textlint -f pretty-error **/*.md",
    "textlint-pretty": "textlint src/textlint-rule-allowed-uris.md --rule allowed-uris ./src -f pretty-error",
    "textlint-stylish": "textlint src/textlint-rule-allowed-uris.md --rule allowed-uris ./src -f stylish",
    "textlint-json": "textlint src/textlint-rule-allowed-uris.md --rule allowed-uris ./src -f json"
  },
  "peerDependencies": {
    "textlint": "^14.0.0 || ^15.0.0"
  },
  "peerDependenciesMeta": {
    "textlint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "editorconfig-checker": "^6.2.0",
    "eslint": "^9.39.5",
    "eslint-config-bananass": "^0.8.0",
    "eslint-markdown": "^0.17.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.8",
    "textlint": "14.7.2",
    "textlint-tester": "14.7.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "parse5": "^8.0.0"
  }
}
